# Copy to .env (gitignored). Used by compose.yaml.

# Must match the Joplin server's APP_BASE_URL exactly (see ../joplin-server/.env) -
# Joplin Server rejects requests whose Origin doesn't match it.
JOPLIN_BASE_URL=http://192.168.10.189:22300

# The dedicated Joplin account this service logs in as - not an admin
# account, ideally its own user so its notes can be scoped/managed separately.
JOPLIN_EMAIL=notes-api@joplin.local
JOPLIN_PASSWORD=change-me

# Third-party clients must send this in the X-API-Key header.
API_KEY=change-me

NOTES_API_PORT=8000
